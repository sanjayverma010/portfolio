    <!-- 2. Mirrors for faster downloads -->
    <mirrors>
        <!-- Aliyun public mirror -->
        <mirror>
            <id>aliyunmaven</id>
            <name>Aliyun Maven Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <mirrorOf>central</mirrorOf>
        </mirror>

        <!-- Google Maven mirror (backup) -->
        <mirror>
            <id>google-maven</id>
            <name>Google Maven Mirror</name>
            <url>https://maven.google.com</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <!-- 3. Profiles (repositories + plugin repos) -->
    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>

            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>

            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <!-- 4. Active profile -->
    <activeProfiles>
        <activeProfile>default</activeProfile>
    </activeProfiles>

</settings>
